; The engine's own marks around every explosion (CWalmarkManager::PlaceWallmarks:
; up to max_count marks of size on the level triangles within dist of the
; blast). G.A.M.M.A. UI sets dist 0.5, size 0.6, max_count 5 with wm\wm_grenade;
; this keeps that texture and adds ZGO's scorch marks, a little larger and
; further out. Only the keys named here change (DLTX "!" override).
![explosion_marks]
wallmarks = wm\wm_grenade,zgo\impacts\scorch_stone_1,zgo\impacts\scorch_stone_2,zgo\impacts\scorch_stone_3,zgo\impacts\scorch_earth_1
dist = 0.8
size = 0.75
max_count = 7
