			{ id = "gibs", type = "check", def = true,
			  name = { "Gibs", "Ошмётки" },
			  desc = { "Chunks thrown by head bursts and explosions: torn-out pieces of the body itself, or meat models (see Gib look).",
			           "Куски, которые разлетаются при разрыве головы и взрывах: вырванные куски самого тела или модели мяса (см. «Вид ошмётков»)." } },
			{ id = "gib_style", type = "list", values = { "body", "meat" }, def = "body", coop = "local",
			  show_if = "dismember/gibs",
			  labels = {
				body = { "Pieces of the body", "Куски самого тела" },
				meat = { "Meat models (as before 1.7.1)", "Модели мяса (как до 1.7.1)" },
			  },
			  name = { "Gib look", "Вид ошмётков" },
			  desc = { "What an explosion or a head burst throws. Pieces of the body: chunks torn out of that body's own model, with its clothes, skin or fur on the outside and raw flesh underneath; each one flies off from the spot it came from, the ones nearest the blast first. Umbra Effects Setup makes them with the baked models (README, BAKED MODELS; a bake from 1.7.1 or newer, about 0.2 MB per body model). A body without them, or wearing a model another mod replaced after the bake, throws meat models. Meat models: G.A.M.M.A.'s mutant meat items, as before. To check: throw a grenade at a body with Pieces of the body: the pieces must wear the body's own clothes and fly out from where they were. If the game shows an error about a model, pick Meat models and report it. Each player's own setting.",
			           "Что разлетается при взрыве или разрыве головы. Куски самого тела: куски, вырванные из модели этого тела, снаружи его одежда, кожа или шерсть, снизу сырое мясо; каждый вылетает с того места, где был, сначала ближайшие к взрыву. Их делает Umbra Effects Setup вместе с запечёнными моделями (README, BAKED MODELS; запекание версии 1.7.1 или новее, около 0,2 МБ на модель тела). Тело без них или с моделью, которую другой мод заменил после запекания, бросает модели мяса. Модели мяса: куски мяса мутантов из G.A.M.M.A., как раньше. Проверка: бросьте гранату в труп при «Куски самого тела»: куски должны быть в одежде этого тела и вылетать с того места, где были. Если игра выдаёт ошибку о модели, выберите «Модели мяса» и сообщите. У каждого игрока своя настройка." } },
			{ id = "stump_caps", type = "check", def = true,
			  name = { "Stump caps", "Культи" },
			  desc = { "Raw meat covers each stump.", "Срез каждой культи закрыт сырым мясом." } },
			{ id = "full_gib", type = "check", def = true,
			  name = { "Full gibbing", "Полное разрывание" },
			  desc = { "Direct RPG hits and IEDs going off underfoot take the whole body apart. Grenades, launcher rounds and mines take limbs, never whole bodies.",
			           "Прямое попадание РПГ и СВУ под ногами разрывают тело целиком. Гранаты, подствольные заряды и мины отрывают конечности, но не разрывают тело." } },
			{ id = "baked_models", type = "check", def = true, coop = "local",
			  name = { "Use baked models", "Запечённые модели" },
			  desc = { "Uses the cut-ready character models made by the model baker (see README, BAKED MODELS): limbs come off corpses too, and late blasts still take parts. Off: behaves as if they were not installed (they stay loaded). Each player's own setting.",
			           "Использует подготовленные к расчленению модели персонажей из запекателя моделей (см. README, BAKED MODELS): конечности отрываются и у трупов, поздние взрывы тоже отрывают части. Выкл.: как будто их нет (остаются загруженными). У каждого игрока своя настройка." } },
		},
	},
	{
		id = "explosions", coop = "host",
		name = { "Explosions", "Взрывы" },
		note = CO_HOST,
		items = {
			{ id = "overpressure", type = "check", def = true,
			  name = { "Realistic blast damage (overrides G.A.M.M.A.)", "Реалистичный урон от взрыва (поверх G.A.M.M.A.)" },
			  desc = { "G.A.M.M.A. armour subtracts its whole explosion protection from a blast, so NPCs could shrug off a grenade at their feet. With this on, the blast does at least what its overpressure would: a hand grenade within about a metre kills most people, at 2 m it hurts, at 3 m it barely does. Armour cuts it (an exoskeleton by about a third), walls in between cut it more. Story characters other mods protect are left alone.",
			           "В G.A.M.M.A. броня вычитает всю защиту от взрыва, и NPC могли не заметить гранату под ногами. Если включено, взрыв наносит не меньше, чем его ударная волна: ручная граната ближе метра убивает почти любого, в 2 м ранит, в 3 м почти безвредна. Броня ослабляет (экзоскелет примерно на треть), стены ослабляют сильнее. Сюжетных персонажей, защищённых другими модами, это не касается." } },
			{ id = "overpressure_scale", type = "track", min = 0.25, max = 2.0, step = 0.05, def = 1.0,
			  name = { "Blast damage strength", "Сила урона от взрыва" },
			  desc = { "Scales the realistic blast damage above. 1 = the tuned values.",
			           "Множитель реалистичного урона выше. 1 = настроенные значения." } },
			{ id = "friendly_blasts", type = "check", def = true,
			  name = { "Grenades hurt allies", "Гранаты ранят своих" },
			  desc = { "G.A.M.M.A. No NPC Friendly Fire also cancels the blast and shrapnel of an NPC grenade on its own side, so it only ever hurt its target. With this on, explosions hurt everyone near them; bullets are still filtered and relations still patched, so allies caught in a blast stay allies.",
			           "G.A.M.M.A. No NPC Friendly Fire отменяет и взрыв с осколками гранаты NPC по своим, так что граната ранила только цель. Если включено, взрывы ранят всех рядом; пули по-прежнему фильтруются, а отношения исправляются, так что задетые союзники остаются союзниками." } },
		},
	},
}

------------------------------------------------------------------------
-- Feature modules add options without editing this file. Each one below,
-- when the file exists, is a script zgo_settings_<name>.script that only
-- defines data:
--   SETTINGS = {
--     { page = "<page id>", items = { ... } },            -- add to an existing page
--     { page = "<new id>", name = { en, ru }, coop = "host" | "local",
--       note = { { en, ru } }, after = "<page id>", items = { ... } },   -- a new page
--   }
-- Items are written exactly like the ones above. Types:
--   check   def = true | false
--   track   min, max, step, def (or perf = { 5 values } on the Performance page)
--   list    values = { v1, v2, ... }, def = v, labels = { [v] = { en, ru } }
--   button  action = "module.function" (called on click; no stored value)
-- Any item or page may have show_if = "<page/id>": shown only while that
-- option is on (e.g. diagnostics only with the debug log on). Options that change what
-- happens in the world are coop = "host"; per-machine ones (drawing,
-- performance) "local". Performance sliders go on the "performance" page
-- with perf = { potato, low, medium, high, ultra }.
------------------------------------------------------------------------
FEATURES = { "world", "props", "cuts", "wounds", "native", "probe", "setup", "kidfx" }

local merged

local function feature_settings(name)
	local mod_name = "zgo_settings_" .. name
	local ok, m = pcall(function() return _G[mod_name] end)
	if ok and type(m) == "table" and type(m.SETTINGS) == "table" then return m.SETTINGS end
	return nil
end

function pages()
	if merged then return merged end
	local list, by_id = {}, {}
	for _, p in ipairs(PAGES) do
		local copy = {}
		for k, v in pairs(p) do copy[k] = v end
		copy.items = {}
		for _, it in ipairs(p.items) do copy.items[#copy.items + 1] = it end
		list[#list + 1] = copy
		by_id[p.id] = copy
	end
	for _, name in ipairs(FEATURES) do
		for _, ext in ipairs(feature_settings(name) or {}) do
			local page = by_id[ext.page]
			if not page then
				page = { id = ext.page, name = ext.name, coop = ext.coop or "local", note = ext.note, show_if = ext.show_if, items = {} }
				by_id[ext.page] = page
				local at = #list + 1
				for i, p in ipairs(list) do if p.id == ext.after then at = i + 1 end end
				table.insert(list, at, page)
			end
			for _, it in ipairs(ext.items or {}) do page.items[#page.items + 1] = it end
		end
	end
	merged = list
	return merged
end

------------------------------------------------------------------------
-- Lookup
------------------------------------------------------------------------
local by_key        -- "page/id" -> item, page
local DEFAULTS = {}

local function index()
	if by_key then return end
	by_key = {}
	local hi
	for i, p in ipairs(PRESETS) do if p == DEFAULT_PRESET then hi = i end end
	for _, page in ipairs(pages()) do
		for _, it in ipairs(page.items) do
			local key = page.id .. "/" .. it.id
			by_key[key] = { item = it, page = page }
			if it.type == "preset" then
				DEFAULTS[key] = DEFAULT_PRESET
			elseif it.perf then
				DEFAULTS[key] = it.perf[hi]
			else
				DEFAULTS[key] = it.def
			end
		end
	end
end

function default(key)
	index()
	return DEFAULTS[key]
end

function keys()
	index()
	local t = {}
	for k in pairs(by_key) do t[#t + 1] = k end
	table.sort(t)
	return t
end

function coop_of(key)
	index()
	local e = by_key[key]
	if not e then return nil end
	return e.item.coop or e.page.coop or "local"
end

-- preset name -> { "page/id" = value } for every option it sets
function preset_values(name)
	index()
	local idx
	for i, p in ipairs(PRESETS) do if p == name then idx = i end end
	if not idx then return nil end
	local t = {}
	for key, e in pairs(by_key) do
		if e.item.perf then t[key] = e.item.perf[idx] end
	end
	return t
end

------------------------------------------------------------------------
-- Reading (cached for a moment: many reads per hit; MCM and xrRazom's host
-- settings push both just write axr_options)
------------------------------------------------------------------------
local cache, cache_t = {}, -1e9
local CACHE_MS = 500

function invalidate() cache, cache_t = {}, -1e9 end

function get(key)
	local now = time_global and time_global() or 0
	if now - cache_t > CACHE_MS or now < cache_t then cache, cache_t = {}, now end
	local v = cache[key]
	if v ~= nil then return v end
	if ui_mcm and ui_mcm.get then
		local ok, mv = pcall(ui_mcm.get, "zgo/" .. key)
		if ok then v = mv end
	end
	if v == nil then v = default(key) end
	if v ~= nil then cache[key] = v end
	return v
end

------------------------------------------------------------------------
-- MCM
------------------------------------------------------------------------
local function title(page_id)
	return { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_zgo_" .. page_id .. "_title", size = { 512, 50 }, spacing = 20 }
end

function mcm()
	index()
	local gr = {}
	for _, page in ipairs(pages()) do
		local g = { title(page.id) }
		for i in ipairs(page.note or {}) do
			g[#g + 1] = { id = "note" .. i, type = "desc", text = "ui_mcm_zgo_" .. page.id .. "_note" .. i, clr = { 255, 200, 200, 200 } }
		end
		for _, it in ipairs(page.items) do
			local n0 = #g
			if it.type == "check" then
				g[#g + 1] = { id = it.id, type = "check", val = 1, def = it.def }
			elseif it.type == "list" then
				local content = {}
				for _, v in ipairs(it.values) do content[#content + 1] = { v } end
				g[#g + 1] = { id = it.id, type = "list", val = type(it.def) == "number" and 2 or 0, def = it.def, content = content }
			elseif it.type == "button" then
				local action = it.action
				g[#g + 1] = { id = it.id, type = "button", functor = { function()
					local mod, fn = string.match(action, "^([%w_]+)%.([%w_]+)$")
					local ok, m = pcall(function() return _G[mod] end)
					local f = ok and m and m[fn]
					if f then
						local ok2, err = pcall(f)
						if not ok2 then zgo_util.log("%s failed: %s", action, tostring(err)) end
					else
						zgo_util.log("button action %s not found", tostring(action))
					end
				end } }
			elseif it.type == "track" then
				g[#g + 1] = { id = it.id, type = "track", val = 2, min = it.min, max = it.max, step = it.step,
					def = default(page.id .. "/" .. it.id) }
			elseif it.type == "preset" then
				local content, presets = {}, {}
				for _, p in ipairs(PRESETS) do
					content[#content + 1] = { p }
					local vals = {}
					for key, v in pairs(preset_values(p)) do
						local pg, id = string.match(key, "^([^/]+)/(.+)$")
						if pg == page.id then vals[id] = v end
					end
					presets[p] = vals
				end
				g[#g + 1] = { id = it.id, type = "preset", val = 0, def = DEFAULT_PRESET, content = content, presets = presets }
			end
			if it.show_if and #g > n0 then
				local key = it.show_if
				g[#g].precondition = { function() return get(key) and true or false end }
			end
		end
		local tree = { id = page.id, sh = true, text = "ui_mcm_zgo_" .. page.id, gr = g }
		if page.show_if then
			local key = page.show_if
			tree.precondition = { function() return get(key) and true or false end }
		end
		gr[#gr + 1] = tree
	end
	return { id = "zgo", sh = false, gr = gr }
end

-- every string the menu needs, for dev/gen_mcm_text.lua: { { id, text }, ... }
-- lang: 1 = English, 2 = Russian
function strings(lang)
	index()
	local out = { { "ui_mcm_menu_zgo", "Umbra Gore & Effects" } }
	for _, page in ipairs(pages()) do
		local base = "ui_mcm_zgo_" .. page.id
		out[#out + 1] = { base, page.name[lang] }
		out[#out + 1] = { base .. "_title", page.id == "general" and "Umbra Gore & Effects" or page.name[lang] }
		for i, n in ipairs(page.note or {}) do out[#out + 1] = { base .. "_note" .. i, n[lang] } end
		for _, it in ipairs(page.items) do
			out[#out + 1] = { base .. "_" .. it.id, it.name[lang] }
			out[#out + 1] = { base .. "_" .. it.id .. "_desc", it.desc[lang] }
			local values = it.type == "preset" and PRESETS or it.values
			for _, v in ipairs(it.labels and values or {}) do
				-- MCM looks list entries up as "<path with _>_lst_<value>"
				out[#out + 1] = { "zgo_" .. page.id .. "_" .. it.id .. "_lst_" .. tostring(v), it.labels[v][lang] }
			end
		end
	end
	return out
end

------------------------------------------------------------------------
-- xrRazom co-op: tell it which settings the host owns (undeclared = local)
------------------------------------------------------------------------
function declare_coop()
	local auth = rawget(_G, "xrr_mcm_authority")
	if auth == nil then
		local ok, m = pcall(function() return xrr_mcm_authority end)
		auth = ok and m or nil
	end
	if not (auth and auth.declare) then return false end
	index()
	for _, page in ipairs(pages()) do
		pcall(auth.declare, "zgo/" .. page.id, page.coop or "local")
		for _, it in ipairs(page.items) do
			if it.coop and it.coop ~= page.coop then
				pcall(auth.declare, "zgo/" .. page.id .. "/" .. it.id, it.coop)
			end
		end
	end
	return true
end

------------------------------------------------------------------------
-- Kid mode
------------------------------------------------------------------------
function gore()
	return zgo_util.gore()
end

local kid_state      -- last applied (nil until the first update)
local armed_state    -- last applied general/kid_particles (lane w)

-- the shader bus lane the blood shaders read: x = 1 hides gore
-- x = 1 hides gore; w = 1 also arms the kid-mode particle shaders (zgo_particle_kid*.ps)
local LANE = "zgo_view"
local lane_ok, lane_token

local function bus()
	local b = rawget(_G, "shader_bus")
	if b == nil then
		local ok, m = pcall(function() return shader_bus end)
		b = ok and m or nil
	end
	return b
end

local function lane_ready(b)
	if lane_ok ~= nil then return lane_ok end
	local function present()
		if not b.has then return nil end
		local ok, r = pcall(b.has, LANE)
		return ok and r and true or false
	end
	local reg = b.try_register or b.register
	local ok, err = false, "no register function"
	if reg then ok, err = pcall(reg, LANE, "Umbra Gore & Effects", "x = 1: kid mode, the blood shaders draw nothing; w = 1: the kid-mode particle shaders too") end
	-- register / try_register return the write token that set() takes
	-- (lua_help_ex.script, shader_bus version 2); nil: another owner holds the id
	if ok then
		if err ~= nil and err ~= false and err ~= true then
			lane_token = err
		elseif err == true then
			ok, err = false, "register gave no write token"
		else
			local owner = b.owner_of and select(2, pcall(b.owner_of, LANE))
			ok, err = false, "the id belongs to " .. tostring(owner)
		end
	end
	local p = present()
	lane_ok = ok and p ~= false
	zgo_util.log("shader bus lane %s: %s", LANE, lane_ok and "registered" or ("not registered (" .. tostring(err) .. "); kid mode can't hide blood already on screen"))
	return lane_ok
end

local function lane_set(kid, armed)
	local b = bus()
	if not (b and b.set and lane_ready(b)) then return false end
	local ok, err = pcall(b.set, lane_token, kid and 1 or 0, 0, 0, (kid and armed) and 1 or 0)
	if not ok or err == false then zgo_util.log("shader bus %s: set failed: %s", LANE, tostring(err)) return false end
	return true
end

-- polled from zgo_main's update; applies a change of kid mode
function update()
	local kid = not gore()
	local armed = kid and zgo_util.setting("general/kid_particles") and true or false
	if kid == kid_state and armed == armed_state then return end
	local kid_changed = kid ~= kid_state
	local first = kid_state == nil
	kid_state, armed_state = kid, armed
	lane_set(kid, armed)
	if not kid_changed then return end
	if first and not kid then return end
	zgo_util.log("kid mode %s", kid and "on: gore hidden" or "off")
	pcall(zgo_fx.kid_mode, kid)
	pcall(zgo_debris.kid_mode, kid)
	pcall(zgo_dismember.kid_mode, kid)
	pcall(zgo_decals.kid_mode, kid)
	pcall(zgo_wounds.kid_mode, kid)
	pcall(zgo_native.kid_mode, kid)
end

function reset()
	kid_state, armed_state, lane_ok, lane_token = nil, nil, nil, nil
	invalidate()
end
