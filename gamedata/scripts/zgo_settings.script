--[[
  Umbra Gore & Effects - settings

  Every option is described once, in PAGES below:
    * where it sits in MCM, its type, range and default
    * its value in each performance preset (perf = { potato, low, medium, high, ultra })
    * who decides it in xrRazom co-op (page or option coop = "host" | "local")
    * its name and explanation, English and Russian
  zgo_mcm builds the menu from it, dev/gen_mcm_text.lua writes the MCM string
  tables from it, and the tests fail when an option has no explanation.

  Co-op: "host" options change what happens in the world (the host decides
  every effect and sends it to everyone), so xrRazom shows the host's values
  on clients and locks them. "local" options (kid mode, performance, logs)
  belong to each machine; the host's effects are drawn within its limits.
]]

PRESETS = { "potato", "low", "medium", "high", "ultra" }
DEFAULT_PRESET = "high"

local CO_HOST = {
	{ "In co-op the host's settings on this page apply to everyone.",
	  "В кооперативе настройки этой страницы задаёт хост, для всех игроков." },
}

PAGES = {
	{
		id = "general", coop = "local",
		name = { "General", "Общие" },
		items = {
			{ id = "enable", type = "check", def = true,
			  name = { "Enable", "Включить" },
			  desc = { "Master switch for every effect in this mod on this computer.",
			           "Главный выключатель всех эффектов мода на этом компьютере." } },
			{ id = "kid_mode", type = "check", def = false,
			  name = { "Kid mode", "Детский режим" },
			  desc = { "Turns gore off at once on this computer: blood on walls, floors and bodies, blood sprays, pools, severed parts, gibs and stumps disappear, including what is already there, and no new gore appears. With baked models, bodies missing limbs get them back. Explosions, sparks, dust and debris stay, and nothing about the game itself changes. Untick it and everything comes back. In co-op it only changes your own screen.",
			           "Сразу отключает кровь и расчленение на этом компьютере: кровь на стенах, полу и телах, брызги, лужи, оторванные части, ошмётки и культи исчезают, в том числе уже появившиеся, и новых не будет. С запечёнными моделями телам возвращаются конечности. Взрывы, искры, пыль и обломки остаются, сама игра не меняется. Снимите галочку, и всё вернётся. В кооперативе меняет только ваш экран." } },
			{ id = "kid_particles", type = "check", def = false, show_if = "general/kid_mode",
			  name = { "Kid mode: hide particles already flying (experimental)", "Детский режим: скрывать уже летящие частицы (экспериментально)" },
			  desc = { "Also hides blood sprays and gore debris that are already on screen when kid mode goes on, and the ones the game plays by itself (knife hits on flesh, anomalies tearing a body), by switching their particle shader off. Needs the xrRazom exe's shader bus and DirectX 10 or 11, and is not tested in game yet. Off: those particles finish playing as usual.",
			           "Также скрывает брызги крови и ошмётки, которые уже на экране при включении детского режима, и те, что игра запускает сама (удары ножом по телу, аномалии, разрывающие тело), отключая их шейдер частиц. Нужны шина шейдеров exe xrRazom и DirectX 10 или 11; в игре ещё не проверено. Выкл.: эти частицы доигрывают как обычно." } },
			{ id = "npc_shooters", type = "check", def = true, coop = "host",
			  name = { "NPC fights bleed too", "Перестрелки NPC тоже с кровью" },
			  desc = { "Hits between NPCs near you (see Performance -> Detail distance) also paint blood and play effects. Dismemberment stays limited to players' kills and explosions. In co-op the host's setting applies.",
			           "Попадания NPC друг в друга рядом с вами (см. Производительность -> Дальность детализации) тоже оставляют кровь и эффекты. Расчленение по-прежнему только от убийств игроков и взрывов. В кооперативе действует настройка хоста." } },
			{ id = "log_explosions", type = "check", def = true,
