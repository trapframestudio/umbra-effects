--[[
  Umbra Gore & Effects - options of the props workstream (zgo_props*):
  hit effects on objects, extra push, leaks, lamps, breaking objects.
  Data only; zgo_settings merges it into the menu (format: zgo_settings.script).

  Destruction is environmental, not gore: kid mode leaves all of it alone.
]]

SETTINGS = {
	{
		page = "props", after = "explosions", coop = "host",
		name = { "Props and destruction", "Предметы и разрушения" },
		note = {
			{ "Objects in the world: what bullets and explosions do to crates, barrels, bottles, lamps and furniture. In co-op the host's settings on this page apply to everyone, except the effects and sounds each player sees and hears. Kid mode does not change any of it.",
			  "Предметы в мире: что пули и взрывы делают с ящиками, бочками, бутылками, лампами и мебелью. В кооперативе настройки этой страницы задаёт хост, для всех игроков, кроме эффектов и звуков, которые каждый видит и слышит сам. Детский режим на них не влияет." },
		},
		items = {
			{ id = "enable", type = "check", def = true,
			  name = { "Enable", "Включить" },
			  desc = { "Master switch for everything on this page. Off: objects behave exactly as in the game without this mod.",
			           "Главный выключатель всего на этой странице. Выкл.: предметы ведут себя как в игре без этого мода." } },
			{ id = "feedback", type = "check", def = true, coop = "local",
			  name = { "Hit effects on objects", "Эффекты попаданий по предметам" },
			  desc = { "Bullets throw material-specific bits off what they hit: wood splinters and dust, sparks from metal, glass shards, paper and cloth fluff, chips from plastic and ceramics. Adds to the game's own impact effects. Each player's own setting.",
			           "Пули выбивают из предметов частицы по материалу: щепки и пыль из дерева, искры из металла, осколки стекла, клочья бумаги и ткани, сколы пластика и керамики. Дополняет собственные эффекты попаданий игры. У каждого игрока своя настройка." } },
			{ id = "push", type = "track", min = 0, max = 3, step = 0.1, def = 1.0,
			  name = { "Extra push from bullets", "Дополнительный толчок от пуль" },
			  desc = { "How much harder bullets shove loose objects, on top of the game's own push. Heavier rounds push more, heavy objects move less. 0 = only the game's own push. In co-op the host applies it once, so everyone sees the same motion.",
			           "Насколько сильнее пули толкают незакреплённые предметы сверх толчка самой игры. Тяжёлые пули толкают сильнее, тяжёлые предметы сдвигаются меньше. 0 = только толчок игры. В кооперативе толчок применяет хост, один раз, поэтому все видят одно и то же движение." } },
			{ id = "blast_push", type = "track", min = 0, max = 3, step = 0.1, def = 1.0,
			  name = { "Explosions throw objects", "Взрывы разбрасывают предметы" },
			  desc = { "Explosions lift and spin loose objects near them instead of only sliding them. 0 = only the game's own push.",
			           "Взрывы подбрасывают и закручивают незакреплённые предметы рядом, а не только сдвигают их. 0 = только толчок игры." } },
			{ id = "leaks", type = "check", def = true,
			  name = { "Leaking containers", "Протекающие ёмкости" },
			  desc = { "A bullet hole in a barrel, canister or milk can below its fill line leaks: a stream and a growing puddle (water, fuel, oil or chemicals, depending on the container) until it has run dry. Gas bottles and fire extinguishers hiss out a jet instead.",
			           "Пробоина в бочке, канистре или бидоне ниже уровня жидкости течёт: струя и растущая лужа (вода, топливо, масло или химия, в зависимости от ёмкости), пока ёмкость не опустеет. Газовые баллоны и огнетушители вместо этого шипят струёй." } },
			{ id = "native_bursts", type = "check", def = true, coop = "local",
			  name = { "Breaking crates burst", "Разлетающиеся ящики" },
			  desc = { "When a crate, board, fence or jar the game itself can break comes apart, it bursts with dust, splinters or glass sized to the object, with a crack. Each player's own setting.",
			           "Когда ящик, доска, забор или банка, которые игра умеет ломать сама, разваливается, он разлетается пылью, щепками или стеклом по своему размеру, с треском. У каждого игрока своя настройка." } },
			{ id = "lamps", type = "check", def = true,
			  name = { "Lamps shatter and flicker", "Лампы бьются и мигают" },
			  desc = { "Shooting a hanging lamp throws glass and sparks; a lamp that survives a hit may flicker for a moment, a lamp that goes out showers shards.",
			           "Выстрел по подвесной лампе выбивает стекло и искры; уцелевшая лампа может на мгновение замигать, погасшая осыпается осколками." } },
			{ id = "breaking", type = "check", def = true,
			  name = { "Objects break apart", "Предметы разрушаются" },
			  desc = { "Small crates, chairs, stools, bottles and jars that the game can't break wear down under fire and explosions and come apart into pieces; barrels and milk cans too, once Umbra Effects Setup has cut their pieces (its Breakable props box). Only objects with a matching set of pieces break (see README, PROPS); quest items, stashes, doors and anything with its own script never do. A broken object stays gone after a reload.",
			           "Небольшие ящики, стулья, табуреты, бутылки и банки, которые игра сломать не может, изнашиваются под огнём и от взрывов и разваливаются на куски; бочки и бидоны тоже, после того как Umbra Effects Setup нарежет для них куски (галочка «Breakable props»). Ломаются только предметы, для которых есть набор кусков (см. README, PROPS); квестовые предметы, тайники, двери и всё со своим скриптом не ломаются никогда. Разрушенный предмет не возвращается после загрузки." } },
			{ id = "toughness", type = "track", min = 0.25, max = 4, step = 0.25, def = 1.0,
			  name = { "Toughness of objects", "Прочность предметов" },
			  desc = { "Multiplies how much damage it takes to break an object. 2 = twice as many hits; 0.5 = half.",
			           "Множитель урона, нужного, чтобы сломать предмет. 2 = вдвое больше попаданий; 0.5 = вдвое меньше." } },
			{ id = "melee_breaks", type = "check", def = true,
			  name = { "Melee breaks objects", "Удары ломают предметы" },
			  desc = { "Knife and other melee hits count toward breaking the objects above (only those the game reports hits on: small crates and similar).",
			           "Удары ножом и другим оружием ближнего боя тоже ломают предметы выше (только те, о попаданиях в которые игра сообщает: небольшие ящики и подобные)." } },
			{ id = "blast_glass", type = "check", def = true,
			  name = { "Explosions break glass", "Взрывы бьют стекло" },
			  desc = { "Bottles, jars and other glass objects near an explosion shatter, and lamps the blast puts out shower glass. Window panes are part of the level and stay whole.",
			           "Бутылки, банки и другие стеклянные предметы рядом со взрывом разбиваются, а погашенные взрывом лампы осыпаются стеклом. Оконные стёкла - часть уровня и остаются целыми." } },
			{ id = "sounds", type = "check", def = true, coop = "local",
			  name = { "Breaking sounds", "Звуки разрушения" },
			  desc = { "A crack, crash or shatter (the game's own material sounds) when an object breaks. Each player's own setting.",
			           "Треск, грохот или звон (звуки материалов самой игры), когда предмет ломается. У каждого игрока своя настройка." } },
		},
	},
	{
		page = "performance",
		items = {
			{ id = "props_fx", type = "track", min = 4, max = 80, step = 2, perf = { 6, 10, 16, 24, 40 },
			  name = { "Object effects per second", "Эффектов от предметов в секунду" },
			  desc = { "Most dust, splinter, spark and glass effects from objects per second (also for those a co-op host sends you); past it, hits on objects show only the game's own effect.",
			           "Наибольшее число эффектов пыли, щепок, искр и стекла от предметов в секунду (и присланных хостом в кооперативе); сверх этого попадания по предметам показывают только эффект самой игры." } },
			{ id = "props_pieces", type = "track", min = 0, max = 96, step = 4, perf = { 8, 16, 28, 40, 64 },
			  name = { "Pieces of broken objects at once", "Обломков предметов одновременно" },
			  desc = { "Pieces of broken crates, chairs and bottles flying or lying around; past this the oldest resting piece is removed. Each flying piece runs a little physics. 0 = objects vanish in a burst of dust instead.",
			           "Обломки ящиков, стульев и бутылок в полёте и на земле; сверх этого убирается самый старый лежащий. Каждый летящий обломок считает немного физики. 0 = предметы исчезают в облаке пыли без обломков." } },
			{ id = "props_pieces_life", type = "track", min = 10, max = 600, step = 10, perf = { 20, 40, 60, 90, 180 },
			  name = { "Pieces: time on the ground (s)", "Обломки: время на земле (с)" },
			  desc = { "Seconds before a piece of a broken object is removed.",
			           "Через сколько секунд обломок предмета исчезает." } },
			{ id = "props_leaks", type = "track", min = 0, max = 16, step = 1, perf = { 1, 2, 4, 6, 10 },
			  name = { "Leaking containers at once", "Протекающих ёмкостей одновременно" },
			  desc = { "Barrels and canisters leaking at the same time; a new leak beyond this stops the oldest. Each leak plays a stream and places a few puddle marks.",
			           "Бочек и канистр, протекающих одновременно; новая течь сверх этого останавливает самую старую. Каждая течь играет струю и оставляет несколько пятен лужи." } },
			{ id = "props_range", type = "track", min = 10, max = 150, step = 5, perf = { 20, 30, 45, 60, 90 },
			  name = { "Object effects distance (m)", "Дальность эффектов предметов (м)" },
			  desc = { "Hits, leaks and breaks farther than this from you show no extra effects (objects still break; the pieces are just not drawn).",
			           "Попадания, течи и разрушения дальше этого расстояния от вас не показывают дополнительных эффектов (предметы всё равно ломаются, только обломки не рисуются)." } },
			{ id = "props_marks_life", type = "track", min = 60, max = 3600, step = 60, perf = { 120, 240, 480, 900, 1800 },
			  name = { "Puddles: lifetime (s)", "Лужи: время жизни (с)" },
			  desc = { "How long puddles from leaking containers stay on the floor.",
			           "Сколько лужи от протекающих ёмкостей остаются на полу." } },
		},
	},
}
