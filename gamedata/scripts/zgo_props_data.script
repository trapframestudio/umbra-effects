	crate = { ref = "dynamics\\box\\box_wood_01", parts = {
		"dynamics\\box\\part\\box_wood_01_part_1", "dynamics\\box\\part\\box_wood_01_part_2",
		"dynamics\\box\\part\\box_wood_01_part_3", "dynamics\\box\\part\\box_wood_01_part_4",
