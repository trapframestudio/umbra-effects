-- visual -> how it breaks
--   set      a PART_SETS entry, fitted into the object's box
--   whole    pieces placed as they are (a damaged copy of the object; its
--            own model space), each { model, still = true when it barely moves }
--   mtl / hp optional overrides (hp: health of this object, not per 20 kg)
RIGS = {
	["dynamics\\box\\box_1a"] = { set = "crate" },
	["dynamics\\box\\box_1b"] = { set = "crate" },
	["dynamics\\box\\box_1c"] = { set = "crate" },
	["dynamics\\box\\box_wood_02"] = { set = "crate" },
	["dynamics\\box\\box_bottle_1"] = { set = "crate", mtl = "wood", extra_fx = "zgo\\props\\glass_burst" },
	["dynamics\\stul\\stul_wood_01"] = { set = "crate" },
	["dynamics\\stul\\stul_child_01"] = { set = "crate" },
	["dynamics\\stul\\taburet_wood_01"] = { set = "crate" },
	["dynamics\\stul\\taburet_village"] = { set = "crate" },
	["dynamics\\stul\\child_bench"] = { set = "crate" },
	["dynamics\\stul\\stul_school_01"] = { whole = { { "dynamics\\stul\\stul_school_01_br", still = true } }, mtl = "wood" },
	["dynamics\\medical_object\\kolyaska_01"] = { mtl = "metal", hp = 160,
		whole = { { "dynamics\\medical_object\\kolyaska_01_braked", still = true }, { "dynamics\\medical_object\\kolyaska_wheel_01_braked" } } },
	["dynamics\\decor\\butilka_vodka_01"] = { set = "jar" },
	["dynamics\\devices\\dev_vodka\\dev_vodka"] = { set = "jar" },
	["dynamics\\devices\\dev_vodka\\dev_vodka2"] = { set = "jar" },
}
-- Glass objects up to this size (largest side, m) that have no rig still
