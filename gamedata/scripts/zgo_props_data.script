------------------------------------------------------------------------
-- Liquids. Containers whose name matches leak this (first match wins).
--   fx: the stream; mark: puddle wallmark sections (mod_system_zgo_props.ltx);
--   jet = true: a gas jet instead of a stream, no puddle
------------------------------------------------------------------------
LIQUIDS = {
	water = { code = "w", fx = "zgo\\props\\leak_water",
		marks = { "zgo_props_puddle_water_1", "zgo_props_puddle_water_2", "zgo_props_puddle_water_3" } },
	fuel = { code = "f", fx = "zgo\\props\\leak_fuel",
		marks = { "zgo_props_puddle_fuel_1", "zgo_props_puddle_fuel_2", "zgo_props_puddle_fuel_3" } },
	oil = { code = "o", fx = "zgo\\props\\leak_oil",
		marks = { "zgo_props_puddle_oil_1", "zgo_props_puddle_oil_2", "zgo_props_puddle_oil_3" } },
	chem = { code = "c", fx = "zgo\\props\\leak_chem",
		marks = { "zgo_props_puddle_chem_1", "zgo_props_puddle_chem_2" } },
	gas = { code = "g", fx = "zgo\\props\\jet_gas", jet = true },
	powder = { code = "p", fx = "zgo\\props\\jet_powder", jet = true },
}
LIQUID_BY_CODE = {}
for name, l in pairs(LIQUIDS) do LIQUID_BY_CODE[l.code] = name end

LEAKERS = {
	{ "bochka_fuel", "fuel" }, { "explosive_barrel", "fuel" }, { "explosive_fuelcan", "fuel" }, { "fuelcan", "fuel" },
