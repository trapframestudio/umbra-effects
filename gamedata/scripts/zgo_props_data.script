--[[
  Umbra Gore & Effects - data for props (zgo_props): materials, liquids, and
  the sets of pieces objects break into. Plain tables, no engine calls.

  Sizes and engine materials of the base game's prop models are generated
  into zgo_props_models.script (tools/zgo_fracture/assets/gen_props_models.py).
  Fracture rigs the player baked (tools/zgo_fracture) are listed in
  zgo_props_fracture_index.script when present.
]]

------------------------------------------------------------------------
-- Material classes
--   hp       health of a 20 kg object of this material (0 = never breaks)
--   bullet / blast / melee   damage multipliers (Source propdata style)
--   fx       hit effects (zgo\props\...), each drawn per hit
--   spark    chance of sparks on top (scaled by the round's energy)
--   burst    effects when one breaks apart
--   sound    breaking sounds (the game's own, sounds\<path>.ogg)
--   code     one letter for co-op lines
------------------------------------------------------------------------
MATERIALS = {
	wood = { code = "w", hp = 32, bullet = 1.0, blast = 1.5, melee = 2.0, spark = 0,
		fx = { "zgo\\props\\splinters", "zgo\\props\\dust_wood" },
