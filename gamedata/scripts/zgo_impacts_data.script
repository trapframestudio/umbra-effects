CLODS = { earth = { "clod_earth_1", "clod_earth_2", "clod_earth_3" }, stone = { "chunk_stone_1", "chunk_stone_2", "chunk_stone_3" } }

-- explosives without a zgo_blast.KINDS entry: TNT relative to a hand grenade
-- from the "blast" value (a hand grenade is 3); see zgo_blast
DEFAULT_CHARGE = 1
