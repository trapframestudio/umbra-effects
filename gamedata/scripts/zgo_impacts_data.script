--[[
  Zone Gore Overhaul - world impact tables (used by zgo_impacts, zgo_impacts_crater)

  Data only. Every name here must exist in the mod:
    * wallmark sections: configs/mod_system_zgo_impacts.ltx
      (zgo_world_<mark>_<family>_<n>, one texture each, under textures/zgo/impacts)
    * particle effects:  particles/zgo/world/*.pe
    * meshes:            meshes/zgo/world/*.ogf (rigid skeletons: script
      attachments R_ASSERT on anything else)
  tests/zgo_test_world.lua checks every name against the files.

  Material families (the engine's material names, from gamemtl.xr and
  materials\materials.ltx, mapped to how a surface takes a hit):
    stone   concrete, asphalt, tiles, slate, the level's "default"
    brick   brick walls (red-brown dust and chips)
    plaster stucco (white dust)
    wood    planks, beams, trunks, furniture
    metal   sheet, plate, pipes, vehicles, barrels (sparks, no dust)
    earth   dirt, sand, grass, gravel (dirt spray, no build-up)
    glass   the engine breaks and marks it; nothing is added
]]

FAMILIES = { "stone", "brick", "plaster", "wood", "metal", "earth", "glass" }
CODE = {}            -- family -> number on the co-op line
for i, f in ipairs(FAMILIES) do CODE[f] = i end

MATERIAL = {
	["default"] = "stone", ["default_object"] = "metal",
	["materials\\concrete"] = "stone", ["materials\\asphalt"] = "stone", ["materials\\flooring_tile"] = "stone",
	["materials\\shifer"] = "stone", ["objects\\concrete_box"] = "stone",
	["materials\\bricks"] = "brick",
	["materials\\stucco"] = "plaster",
	["materials\\wood"] = "wood", ["materials\\wooden_board"] = "wood", ["materials\\tree_trunk"] = "wood",
	["objects\\small_box"] = "wood", ["objects\\large_furniture"] = "wood",
	["materials\\metal"] = "metal", ["materials\\metal_plate"] = "metal", ["materials\\metal_pipe"] = "metal",
	["materials\\tin"] = "metal", ["materials\\setka_rabica"] = "metal",
	["objects\\barrel"] = "metal", ["objects\\metal_box"] = "metal", ["objects\\car_cabine"] = "metal",
	["objects\\large_metal_trash"] = "metal", ["objects\\small_metal_trash"] = "metal", ["objects\\tin_can"] = "metal",
	["objects\\fuel_can"] = "metal", ["objects\\large_weapon"] = "metal", ["objects\\small_weapon"] = "metal",
	["objects\\car_wheel"] = "metal",
	["materials\\earth"] = "earth", ["materials\\dirt"] = "earth", ["materials\\sand"] = "earth",
	["materials\\grass"] = "earth", ["materials\\gravel"] = "earth", ["materials\\earth_slide"] = "earth",
	["materials\\glass"] = "glass", ["objects\\glass"] = "glass", ["objects\\bottle"] = "glass",
}
-- materials that take nothing (water, foliage, cloth, invisible helpers)
NONE = {
	["materials\\water"] = true, ["materials\\water_radiation"] = true, ["materials\\bush"] = true,
	["materials\\bush_sux"] = true, ["materials\\cloth"] = true, ["objects\\clothes"] = true,
