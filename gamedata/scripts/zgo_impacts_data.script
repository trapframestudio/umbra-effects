	["materials\\fake_slide"] = true, ["materials\\occ"] = true, ["materials\\death"] = true,
	["materials\\earth_death"] = true, ["objects\\bullet"] = true, ["objects\\shell"] = true, ["objects\\bolt"] = true,
}
-- materials added by other mods: guess from the name (first match wins)
GUESS = {
	{ "glass", "glass" }, { "brick", "brick" }, { "stucco", "plaster" }, { "plaster", "plaster" },
	{ "concrete", "stone" }, { "beton", "stone" }, { "asphalt", "stone" }, { "tile", "stone" }, { "stone", "stone" }, { "rock", "stone" },
	{ "wood", "wood" }, { "board", "wood" }, { "tree", "wood" }, { "plank", "wood" }, { "furniture", "wood" },
	{ "metal", "metal" }, { "tin", "metal" }, { "iron", "metal" }, { "steel", "metal" }, { "pipe", "metal" }, { "car", "metal" },
	{ "earth", "earth" }, { "dirt", "earth" }, { "sand", "earth" }, { "grass", "earth" }, { "gravel", "earth" }, { "mud", "earth" },
}
