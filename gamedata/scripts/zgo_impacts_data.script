------------------------------------------------------------------------
-- How each family takes damage
--   marks:   decal per stage; false = that stage is never reached
--   thr:     built-up energy (1 = an intermediate rifle round) for crack,
--            gouge and breach in one spot
--   chip:    chance of a chip mark per round (+ per calibre class)
--   size:    chip half-size in metres per calibre class 1..5
--   stage:   half-size of the crack / gouge / breach marks
--   fx:      particle effects (see FX below)
------------------------------------------------------------------------
FAMILY = {
	stone = {
		marks = { "chip", "crack", "gouge", "breach" }, thr = { 3.0, 7.0, 15.0 },
		chip = { 0.3, 0.15 }, size = { 0.035, 0.05, 0.065, 0.08, 0.12 }, stage = { 0.11, 0.13, 0.2 },
		fx = { "dust_stone", "chips_stone" }, big = "dust_big_stone", burst = "breach_stone",
	},
	brick = {
		marks = { "chip", "crack", "gouge", "breach" }, thr = { 2.5, 6.0, 12.0 },
		chip = { 0.35, 0.15 }, size = { 0.04, 0.055, 0.07, 0.085, 0.13 }, stage = { 0.11, 0.14, 0.21 },
		fx = { "dust_brick", "chips_brick" }, big = "dust_big_brick", burst = "breach_brick",
	},
	plaster = {
		marks = { "chip", "crack", "gouge", "breach" }, thr = { 1.8, 4.5, 9.0 },
		chip = { 0.45, 0.15 }, size = { 0.045, 0.06, 0.075, 0.09, 0.14 }, stage = { 0.12, 0.15, 0.22 },
		fx = { "dust_plaster", "chips_plaster" }, big = "dust_big_plaster", burst = "breach_plaster",
	},
	wood = {
		marks = { "chip", "split", "gouge", "breach" }, thr = { 1.5, 4.0, 8.0 },
		chip = { 0.4, 0.15 }, size = { 0.035, 0.05, 0.065, 0.08, 0.11 }, stage = { 0.1, 0.13, 0.19 },
		fx = { "splinters_wood", "dust_wood" }, big = "dust_big_wood", burst = "breach_wood",
	},
	metal = {
		marks = { "chip", "dent", "tear", false }, thr = { 2.5, 6.0, 1e9 },
		chip = { 0.45, 0.12 }, size = { 0.025, 0.035, 0.045, 0.055, 0.08 }, stage = { 0.08, 0.1, 0.1 },
		fx = { "sparks_metal", "smoke_metal" }, big = "sparks_big_metal", burst = "sparks_big_metal",
	},
	earth = {
		marks = { "splash", false, false, false }, thr = { 1e9, 1e9, 1e9 },
		chip = { 0.05, 0.2 }, size = { 0.05, 0.07, 0.09, 0.11, 0.16 }, stage = { 0.1, 0.1, 0.1 },
		fx = { "dirt_earth", "dust_earth" }, big = "dust_big_earth", burst = "dust_big_earth",
	},
}

-- texture variants per mark kind and family (sections zgo_world_<mark>_<family>_<n>)
VARIANTS = {
	chip = { stone = 3, brick = 3, plaster = 3, wood = 3, metal = 3 },
	crack = { stone = 3, brick = 3, plaster = 3 },
	split = { wood = 2 },
	gouge = { stone = 2, brick = 2, plaster = 2, wood = 2 },
	breach = { stone = 2, brick = 2, plaster = 2, wood = 2 },
	dent = { metal = 2 },
	tear = { metal = 2 },
	splash = { earth = 3 },
	scorch = { stone = 3, earth = 3 },
	pock = { all = 3 },
	crater = { stone = 2, earth = 2 },
}
MARK_CODE = { chip = 1, crack = 2, split = 2, dent = 2, gouge = 3, tear = 3, breach = 4, splash = 5, scorch = 6, pock = 7, crater = 8 }

-- the decal shader route (zgo_settings: world/deep_marks): the same marks with
-- textures under zgo\impacts\deep\, which effects_wallmark.s hands to the
-- zgo_wm_* shaders (see shaders/r3). Section names add "_d".
DEEP = { chip = true, crack = true, split = true, gouge = true, breach = true, dent = true, tear = true, scorch = true, crater = true }

function section(mark, fam, n, deep)
	local v = VARIANTS[mark]
	if not v then return nil end
	local count = v[fam] or v.all
	if not count then return nil end
	n = math.max(1, math.min(count, n or 1))
	local s = "zgo_world_" .. mark .. "_" .. (v[fam] and fam or "all") .. "_" .. n
	if deep and DEEP[mark] then s = s .. "_d" end
	return s
end

function variants(mark, fam)
	local v = VARIANTS[mark]
	return v and (v[fam] or v.all) or 0
end

------------------------------------------------------------------------
-- Particle effects (particles/zgo/world). None of them is gore.
------------------------------------------------------------------------
FX_DIR = "zgo\\world\\"
FX = {
	"dust_stone", "dust_brick", "dust_plaster", "dust_wood", "dust_earth",
	"dust_big_stone", "dust_big_brick", "dust_big_plaster", "dust_big_wood", "dust_big_earth",
	"chips_stone", "chips_brick", "chips_plaster", "splinters_wood", "dirt_earth",
	"sparks_metal", "sparks_big_metal", "smoke_metal",
	"breach_stone", "breach_brick", "breach_plaster", "breach_wood",
	"crater_ring_earth", "crater_ring_stone", "crater_column_earth", "crater_column_stone",
	"crater_clods_earth", "crater_clods_stone", "crater_smoke", "crater_flash_dust",
	"ceiling_grit", "ceiling_dust",
}
function fx(name) return name and (FX_DIR .. name) or nil end

