// Umbra Gore & Effects, kid mode for particles: r3\particle.ps from base:shaders.db0 (sha1 bdb4dba7677b92791e508c772cb2e5801c4396ef)
// with two lines added, both marked "ZGO kid mode": the shader bus uniform bus_zgo_view and a
// discard while x (kid mode) is on and w = 1 (the experimental option is on). With the lane at 0
// or never set the shader does exactly what the stock one does.
// Generated by tools/zgo_kidfx/kidfx_pe.py shaders --write (rebuild it when another mod
// changes particle.ps); compiled by dev/shadercheck/check.sh.
// shadercheck-baseline: particle.ps

#include "common.h"
uniform float4 bus_zgo_view;	// ZGO kid mode (shader bus): x = 1 kid mode, w = 1 hide particles on screen

struct v2p
{
	float2 tc0	: TEXCOORD0;
	float4 c	: COLOR0;

//	Igor: for additional depth dest
#ifdef	USE_SOFT_PARTICLES
	float4 tctexgen	: TEXCOORD1;
#endif	//	USE_SOFT_PARTICLES
	float  fog : FOG;		// fog
	float4 hpos	: SV_Position;
};

//	Must be less than view near
#define	DEPTH_EPSILON	0.1h
//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( v2p I ) : SV_Target
{
	if (bus_zgo_view.x > 0.5 && abs(bus_zgo_view.w - 1.0) < 0.001) discard;	// ZGO kid mode
	float4 result = I.c * s_base.Sample(smp_base, I.tc0);

	//	Igor: additional depth test
#ifdef	USE_SOFT_PARTICLES
	float2 tcProj = I.tctexgen.xy / I.tctexgen.w;

	gbuffer_data gbd = gbuffer_load_data(tcProj, I.hpos);

	float4 _P = float4(gbd.P, gbd.mtl);
	float spaceDepth = _P.z - I.tctexgen.z - DEPTH_EPSILON;
	if (spaceDepth < -2 * DEPTH_EPSILON) spaceDepth = 100000.0h; //  Skybox doesn't draw into position buffer
	result.a *= Contrast(saturate(spaceDepth*1.3h), 2);
	result.rgb *= Contrast(saturate(spaceDepth*1.3h), 2);
#endif	//	USE_SOFT_PARTICLES

	clip(result.a - (0.01f / 255.0f));
	result.a *= I.fog*I.fog; // ForserX: Port Skyloader fog fix
	return	result;
}